# Android's gallery lives under DCIM. Everything we download goes into
# DCIM/ytdlmux so the phone's Gallery app picks it up automatically.
GALLERY_SUBDIR = "ytdlmux"

DOWNLOAD_DIRS = [
    Path("/storage/emulated/0/DCIM") / GALLERY_SUBDIR,   # Android DCIM (gallery)
    Path("/sdcard/DCIM") / GALLERY_SUBDIR,
    Path.home() / "storage" / "dcim" / GALLERY_SUBDIR,   # Termux symlink fallback
    Path.home() / "storage" / "downloads",               # last resort
    Path.home() / "Downloads",
]


def is_gallery_dir(path) -> bool:
    """True if `path` is (inside) the DCIM/ytdlmux gallery folder."""
    try:
        p = Path(path).resolve()
    except OSError:
        return False
    for base in DOWNLOAD_DIRS[:3]:
        try:
            b = base.resolve()
        except OSError:
            continue
        if p == b or b in p.parents:
            return True
    return False


def find_download_dir() -> Path:
    """First writable destination, preferring the DCIM gallery folder."""
    for cand in DOWNLOAD_DIRS:
        try:
            if cand.is_dir() and os.access(cand, os.W_OK):
                return cand
        except OSError:
            continue
    # DCIM exists but our subfolder does not yet -> create it there.
    for cand in DOWNLOAD_DIRS[:3]:
        try:
            cand.mkdir(parents=True, exist_ok=True)
            if os.access(cand, os.W_OK):
                return cand
        except OSError:
            continue
    return Path.home()


def fmt_bytes(n) -> str:
    if not n:
        return "?"
    n = float(n)
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return f"{n:.1f} {unit}" if unit != "B" else f"{int(n)} B"
        n /= 1024
    return "?"


def fmt_dur(sec) -> str:
    try:
        sec = int(float(sec))
    except (TypeError, ValueError):
        return "?"
    h, rem = divmod(sec, 3600)
    m, s = divmod(rem, 60)
    return f"{h}:{m:02d}:{s:02d}" if h else f"{m}:{s:02d}"


def fmt_eta(sec) -> str:
    try:
        sec = int(float(sec))
    except (TypeError, ValueError):
        return "--:--"
    if sec < 0:
        return "--:--"
    h, rem = divmod(sec, 3600)
    m, s = divmod(rem, 60)
    return f"{h}:{m:02d}:{s:02d}" if h else f"{m:02d}:{s:02d}"


def fmt_views(v) -> str:
    if not v:
        return ""
    for unit, div in (("B", 10 ** 9), ("M", 10 ** 6), ("K", 10 ** 3)):
        if v >= div:
            return f"{v / div:.1f}{unit} views"
    return f"{v} views"


def human_int(v) -> str:
    return f"{v:,}".replace(",", ".")


