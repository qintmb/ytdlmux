class SpeedColumn(ProgressColumn):
    """Download speed reported by yt-dlp."""

    def render(self, task) -> Text:
        if task.fields.get("_overall"):
            return Text("")
        speed = task.fields.get("speed")
        if not speed:
            return Text("  -- B/s", style=DIM)
        return Text(f"{fmt_bytes(speed)}/s", style=f"bold {WARN}")


class SizeColumn(ProgressColumn):
    """Bytes done / total, laid out to a fixed width and blank until known.

    rich's DownloadColumn keeps the "? / ?" placeholder visible, which makes
    the first seconds of a download look broken; a stable empty gutter reads
    better and stops the row from jumping when the total arrives.
    """

    def render(self, task) -> Text:
        if not task.total:
            return Text(" " * 14)
        total = float(task.total)
        done = float(task.completed or 0)
        # "68.4/71.7 MB" -- the unit is printed once, so the row stays narrow
        # enough to keep speed and ETA on the same line at 80 columns.
        d_str, t_str = fmt_bytes(done), fmt_bytes(total)
        d_num = d_str.rsplit(" ", 1)[0]
        t_num, t_unit = (t_str.rsplit(" ", 1) + [""])[:2] if " " in t_str else (t_str, "")
        return Text(f"{d_num}/{t_num} {t_unit}".rstrip(), style=f"bold {OK}")


class SmoothBarColumn(ProgressColumn):
    """Width-flexible Unicode bar with semantic colour.

    rich's built-in BarColumn cannot express the two-tone fill or the finished
    state we want, so we draw it ourselves.
