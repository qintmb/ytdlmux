AUDIO_CHOICE = {"kind": "audio_mp3"}


def js_runtimes():
    """Pick an available JS runtime so YouTube extraction stays supported."""
    for rt in ("node", "deno", "bun", "qjs"):
        if shutil.which(rt):
            return {rt: {}}
    return None


def _extract(url: str, playlist: bool, cookies_from_browser=None):
    """Fetch metadata without downloading."""
    from yt_dlp import YoutubeDL

    opts = {
        "quiet": True,
        "no_warnings": True,
        "noprogress": True,
        "skip_download": True,
        "noplaylist": not playlist,
        "extract_flat": False,
        "socket_timeout": 20,
        "retries": 3,
        "ignoreerrors": False,
    }
    rt = js_runtimes()
    if rt:
        opts["js_runtimes"] = rt
    with YoutubeDL(opts) as ydl:
        return ydl.extract_info(url, download=False)


def _entry(info):
    """First real video entry of a playlist, if any."""
    if info.get("_type") == "playlist":
        for e in info.get("entries") or []:
            if e:
                return e
        raise RuntimeError("empty playlist")
    return info


def _est_size(fmt, duration) -> int:
    size = fmt.get("filesize") or fmt.get("filesize_approx")
    if size:
        return int(size)
    tbr = fmt.get("tbr")
    if tbr and duration:
        return int(tbr * 1000 / 8 * duration)
    return 0


def build_choices(info):
    """Group formats by height -> list of picker entries."""
    formats = info.get("formats") or []
    duration = info.get("duration")
    video = [f for f in formats if f.get("vcodec") not in (None, "none")]
    audio = [f for f in formats if f.get("acodec") not in (None, "none")
             and f.get("vcodec") in (None, "none")]

    best_audio = None
    for a in audio:
        score = (a.get("abr") or 0, _est_size(a, duration))
        if best_audio is None or score > best_audio[0]:
            best_audio = (score, a)
    best_audio_fmt = best_audio[1] if best_audio else None
    audio_size = _est_size(best_audio_fmt, duration) if best_audio_fmt else 0

    # best video per height
    per_height = {}
    for f in video:
        h = f.get("height")
        if not h:
            continue
        key = h
        score = (
            f.get("fps") or 0,
            f.get("vcodec", "").startswith("avc1"),   # prefer H.264 (Android-friendly)
            f.get("tbr") or 0,
            _est_size(f, duration),
        )
        if key not in per_height or score > per_height[key][0]:
            per_height[key] = (score, f)

    choices = []
    # 1) best auto
    choices.append((
        "[ BEST ]  Best quality (auto)   — best video+audio available",
        {"kind": "auto"},
    ))

    # 2) per resolution, highest first
    for h in sorted(per_height, reverse=True):
        f = per_height[h][1]
        fps = f.get("fps")
        ext = f.get("ext") or "?"
        total = _est_size(f, duration) + audio_size
        note = f.get("format_note") or ""
        label = f"{h}p"
        if fps and fps >= 50:
            label += f"{int(fps)}"
        extra = f" · {note}" if note and note not in label else ""
        size = f"  ~{fmt_bytes(total)}" if total else "  (size ?)"
        star = "  ⭐" if h >= 1080 else ""
        choices.append((
            f"[ {label:<7} ]  {ext:<4} video+audio{size}{extra}{star}",
            {"kind": "video", "format_id": f.get("format_id"), "height": h,
             "label": label, "ext": ext},
        ))

    # 3) audio options
    choices.append((
        "[ AUDIO ]  MP3 320 kbps (ffmpeg conversion)",
        AUDIO_CHOICE,
    ))
    choices.append((
        "[ AUDIO ]  Original M4A (no conversion, faster)",
        {"kind": "audio_m4a"},
    ))
    return choices


def pick_with_prompt_toolkit(choices, title, subtitle):
    from prompt_toolkit.formatted_text import HTML
    from prompt_toolkit.shortcuts import radiolist_dialog
    from prompt_toolkit.styles import Style

    style = Style.from_dict({
        "dialog": "bg:#0f172a",
        "dialog frame.label": "bg:#0f172a #22d3ee bold",
        "dialog.body": "bg:#0f172a #e2e8f0",
        "dialog shadow": "bg:#020617",
        "radio-selected": "bg:#1e293b #22d3ee bold",
        "radio-checked": "#22d3ee bold",
        "radio": "#e2e8f0",
        "button": "bg:#334155 #e2e8f0",
        "button.focused": "bg:#22d3ee #0f172a bold",
    })

    result = radiolist_dialog(
        title=title,
        text=HTML(
            f"<b>{subtitle}</b>\n"
            "<ansigray>↑/↓ select · Enter download · Ctrl-C cancel</ansigray>"
        ),
        values=[(i, label) for i, (label, _) in enumerate(choices)],
        style=style,
    ).run()
    return None if result is None else choices[result][1]


def pick_fallback(choices, title, subtitle):
    """Plain numbered menu when prompt_toolkit is unavailable."""
    console.print()
    console.print(Panel.fit(
        Text(subtitle, style="bold"), title=title, border_style=ACCENT))
    for i, (label, _) in enumerate(choices, 1):
        console.print(f"  [bold {ACCENT}]{i:>2}[/]  {label}")
    console.print()
    while True:
        raw = console.input(f"[bold {ACCENT}]Pick a number[/] (Enter=1, q=cancel): ").strip()
        if raw.lower() in ("q", "quit", "exit"):
            return None
        if raw == "":
            return choices[0][1]
        if raw.isdigit() and 1 <= int(raw) <= len(choices):
            return choices[int(raw) - 1][1]
        console.print(f"[{BAD}]Invalid number.[/]")


def choose_format(url, args, outdir):
    """Return (label, format_selector, postprocessors, kind) or None if cancelled."""
    if args.audio:
        return ("MP3 320 kbps", "bestaudio/best", _audio_pp(), "audio")
    if args.format:
        return (args.format, args.format, None, "custom")

    interactive = sys.stdin.isatty() and sys.stdout.isatty()
    if args.yes or not interactive:
        return ("Best available", _best_selector(), None, "auto")

    with console.status(f"[{ACCENT}]Fetching format list…[/]", spinner="dots"):
        try:
            info = _entry(_extract(url, args.playlist))
        except Exception as exc:                                  # noqa: BLE001
            console.print(Panel(Text(str(exc), style=BAD),
                                title="[bold red]Failed to fetch info[/]",
                                border_style=BAD))
            return None

    title = info.get("title") or url
    uploader = info.get("uploader") or info.get("channel") or "?"
    dur = info.get("duration")
    views = info.get("view_count")

    sub = f"{title}\n"
    sub += f"{uploader}"
    if dur:
        sub += f"  ·  {fmt_dur(dur)}"
    if views:
        sub += f"  ·  {fmt_views(views)}"

    choices = build_choices(info)
    try:
        picked = pick_with_prompt_toolkit(choices, " dl — pick quality ", sub)
    except Exception:                                             # noqa: BLE001
        picked = pick_fallback(choices, "dl — pick quality", sub)

    if picked is None:
        return None

    kind = picked["kind"]
    return choice_to_plan(picked)


def choice_to_plan(picked):
    """Map a picker entry to (label, yt-dlp format selector, postprocessors, kind)."""
    kind = picked.get("kind")
    if kind == "auto":
        return ("Best available", _best_selector(), None, "auto")
    if kind == "video":
        fid = picked.get("format_id")
        if not fid:
            return ("Best available", _best_selector(), None, "auto")
        sel = f"{fid}+bestaudio/{fid}+best/{fid}/best"
        return (f"{picked.get('label', fid)} {picked.get('ext', '')}".strip(),
                sel, None, "video")
    if kind == "audio_m4a":
        return ("M4A (original)", "bestaudio[ext=m4a]/bestaudio/best", None, "audio")
    if kind == "audio_mp3":
        return ("MP3 320 kbps", "bestaudio/best", _audio_pp(), "audio")
    return ("Best available", _best_selector(), None, "auto")


def _best_selector() -> str:
    # prefer mp4/m4a for maximum Android player compatibility, fall back to anything
    return "bestvideo*[ext=mp4]+bestaudio[ext=m4a]/bestvideo*+bestaudio/best"


def _audio_pp():
    return [
        {"key": "FFmpegExtractAudio", "preferredcodec": "mp3", "preferredquality": "320"},
        {"key": "FFmpegMetadata"},
    ]


