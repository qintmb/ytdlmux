def parse_args(argv=None):
    p = argparse.ArgumentParser(
        prog="dl",
        description="yt-dlp TUI downloader for Termux/Android, macOS, Linux & Windows "
                    "(auto-saves to your gallery/video folder).",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="examples:\n"
               "  dl https://youtube.com/watch?v=xxxx\n"
               "  dl -a https://youtu.be/xxxx\n"
               "  dl -y -p https://youtube.com/playlist?list=xxxx\n"
               "  dl                       # URL from the clipboard\n"
               "  dl -U                    # update yt-dlp + ytdlmux\n",
    )
    p.add_argument("urls", nargs="*", help="video/audio URL (empty = take from clipboard)")
    p.add_argument("-a", "--audio", action="store_true", help="audio only, convert to MP3 320k")
    p.add_argument("-y", "--yes", action="store_true", help="skip the resolution picker (best quality)")
    p.add_argument("-f", "--format", help="manual yt-dlp format selector")
    p.add_argument("-p", "--playlist", action="store_true", help="download the whole playlist")
    p.add_argument("--playlist-items", help="playlist subset, e.g. 1-5")
    p.add_argument("-l", "--list", action="store_true", help="show the format list then exit")
    p.add_argument("-o", "--out", help="target folder (default: the gallery/video folder)")
    p.add_argument("-s", "--sub", action="store_true", help="download + embed subtitles (id/en)")
    p.add_argument("-x", "--proxy", help="proxy, e.g. socks5://127.0.0.1:1080")
    p.add_argument("--limit-rate", type=int, help="speed limit in bytes/second")
    p.add_argument("-U", "--update", action="store_true",
                   help="update yt-dlp + ytdlmux from the latest release, then exit")
    p.add_argument("-V", "--version", action="store_true", help="dl version")
    p.add_argument("-q", "--quiet", action="store_true",
                   help="suppress environment warnings")
    return p.parse_args(argv)


def main(argv=None) -> int:
    args = parse_args(argv)

    if args.version:
        try:
            import yt_dlp
            ytv = yt_dlp.version.__version__
        except ImportError:
            ytv = "not installed"
        plat = ("Android/Termux" if IS_ANDROID else
                "macOS" if IS_MAC else "Windows" if IS_WIN else "Linux")
        py = f"{sys.version_info.major}.{sys.version_info.minor}.{sys.version_info.micro}"
        console.print(f"ytdlmux {VERSION}  ·  command: dl  ·  {plat}")
        console.print(f"yt-dlp {ytv}  ·  python {py}  ·  {sys.executable}")
        if _python_too_old():
            console.print(f"[{WARN}]⚠ python {py} is old — yt-dlp may fail to "
                          f"extract YouTube. Upgrade: {_python_hint()}[/]")
        return 0

    if args.update:
        return self_update()

    try:
        import yt_dlp  # noqa: F401
    except ImportError:
        console.print(f"[{BAD}]yt-dlp is not installed.[/] Run: pip install -U yt-dlp")
        return 1

    # Old Pythons break modern YouTube extraction; say so now rather than
    # letting it surface later as an opaque "page needs to be reloaded" error.
    if _python_too_old() and not args.quiet:
        console.print(
            f"[{WARN}]⚠ python {sys.version_info.major}.{sys.version_info.minor} "
            f"is deprecated by yt-dlp — YouTube downloads may fail.[/]\n"
            f"[{DIM}]  Upgrade: {_python_hint()}[/]\n"
            f"[{DIM}]  Other interpreters found: "
            f"{', '.join(_other_pythons()) or 'none'}[/]")

    outdir = Path(args.out).expanduser() if args.out else find_download_dir()
    try:
        outdir.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        console.print(f"[{BAD}]Cannot use folder {outdir}: {exc}[/]")
        return 1

    urls = list(args.urls)
    if not urls:
        clip = clipboard_url()
        if clip:
            console.print(f"[{DIM}]URL from clipboard:[/] [white]{clip}[/]")
            urls = [clip]
        else:
            hint = ("copy a URL to the clipboard and just run [bold]dl[/]"
                    if clipboard_supported() else
                    "pass a URL: [bold]dl <url>[/]")
            console.print(
                f"[{WARN}]No URL given.[/]\n"
                f"Use: [bold {ACCENT}]dl <url>[/]   (or {hint})")
            return 1

    if args.list:
        for u in urls:
            list_formats(u, args)
        return 0

    if not shutil.which("ffmpeg"):
        if IS_ANDROID:
            how = "pkg install ffmpeg"
        elif IS_MAC:
            how = "brew install ffmpeg"
        elif IS_WIN:
            how = "winget install Gyan.FFmpeg"
        else:
            how = "sudo apt install ffmpeg   (or your distro's package manager)"
        console.print(f"[{WARN}]⚠ ffmpeg not found — merging video+audio may fail.[/]\n"
                      f"[{DIM}]  {how}[/]")

    wake_lock(True)
    rc = 0
    try:
        for i, url in enumerate(urls, 1):
            if len(urls) > 1:
                console.rule(f"[bold {ACCENT}]URL {i}/{len(urls)}[/]", style=ACCENT)
            chosen = choose_format(url, args, outdir)
            if chosen is None:
                console.print(f"[{WARN}]Skipped:[/] {url}")
                continue
            label, selector, pps, _kind = chosen

            dl = Downloader(outdir, args)
            dl.current_label = label
            if not dl.download(url, selector, pps):
                rc = 1
            else:
                notify("dl — done", f"{label} → {outdir}")
    finally:
        wake_lock(False)
    return rc


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        console.print(f"\n[{WARN}]Cancelled.[/]")
        sys.exit(130)
