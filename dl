def list_formats(url, args):
    with console.status(f"[{ACCENT}]Fetching format list…[/]", spinner="dots"):
        try:
            info = _entry(_extract(url, args.playlist))
        except Exception as exc:                                  # noqa: BLE001
            console.print(f"[{BAD}]✖ {exc}[/]")
            return
    table = Table(title=f"[bold]{info.get('title')}[/]", box=box.SIMPLE_HEAVY,
                  border_style=ACCENT, header_style=f"bold {ACCENT}")
    for col in ("id", "ext", "resolution", "fps", "vcodec", "acodec", "abr", "size", "note"):
        table.add_column(col)
    for f in info.get("formats") or []:
        size = f.get("filesize") or f.get("filesize_approx")
        table.add_row(
            str(f.get("format_id")), str(f.get("ext")),
            str(f.get("resolution") or (f"{f['height']}p" if f.get("height") else "audio")),
            str(f.get("fps") or "-"), str(f.get("vcodec") or "-"),
            str(f.get("acodec") or "-"),
            str(f.get("abr") or "-"), fmt_bytes(size) if size else "-",
            str(f.get("format_note") or ""),
        )
    console.print(table)


