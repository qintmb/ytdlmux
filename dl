class PercentColumn(ProgressColumn):
    """Right-aligned percentage, blank while the total is unknown."""

    def render(self, task) -> Text:
        if not task.total:
            frames = ("   ", "·  ", "·· ", "···")
            step = task.fields.get("_spin", 0)
            return Text(frames[step % len(frames)], style=DIM)
        pct = task.completed / task.total * 100 if task.total else 0
        return Text(f"{pct:>4.0f}%", style=f"bold {ACCENT}")


class IconColumn(ProgressColumn):
    """Leading icon: an animated dot for the overall row, else the kind glyph."""

    def render(self, task) -> Text:
        if task.fields.get("_overall"):
            frames = ("◐", "◓", "◑", "◒")
            step = task.fields.get("_spin", 0)
            return Text(frames[step % len(frames)] + " ", style=f"bold {ACCENT}")
        desc = task.description or ""
        icon = desc.split(" ", 1)[0] if desc else ""
        return Text(f"{icon} ", style=f"bold {ACCENT}")


class LabelColumn(ProgressColumn):
    """Download label with the icon stripped (the icon has its own column)."""

    def render(self, task) -> Text:
        desc = task.description or ""
        if task.fields.get("_overall"):
            return Text(f"{desc:<16}", style=f"bold {ACCENT}")
        parts = desc.split(" ", 1)
        name = parts[1] if len(parts) > 1 else desc
        style = f"bold {OK}" if task.finished else "bold white"
        return Text(f"{name:<16}", style=style)


class SuiteTimeColumn(ProgressColumn):
    """Elapsed time — only meaningful on the aggregate row."""

    def render(self, task) -> Text:
        if not task.fields.get("_overall"):
            return Text("")
        elapsed = task.elapsed
        if elapsed is None:
            return Text("")
        return Text(f"  {fmt_dur(elapsed)}", style=f"bold white")


class EtaColumn(ProgressColumn):
    """Time left reported by yt-dlp."""

    def render(self, task) -> Text:
        if task.fields.get("_overall"):
            return Text("")
        eta = task.fields.get("eta")
        if eta is None:
            return Text("  --:--", style=DIM)
        return Text(f"  {fmt_eta(eta)}", style=f"bold {ACCENT}")


