# Android's gallery lives under DCIM; desktops get a per-OS video folder.
GALLERY_SUBDIR = "ytdlmux"

_desktop_dirs: list[Path] = []
if IS_ANDROID:
    pass                       # Android uses the DCIM paths below, not ~/Videos
elif IS_MAC:
    _desktop_dirs.append(Path.home() / "Movies" / GALLERY_SUBDIR)
else:
    # Linux / BSD / Windows: XDG user dir when set, else the spec default.
    _xdg = os.environ.get("XDG_VIDEOS_DIR")
    if _xdg:
        _desktop_dirs.append(Path(_xdg).expanduser() / GALLERY_SUBDIR)
    _desktop_dirs.append(Path.home() / "Videos" / GALLERY_SUBDIR)

# Android paths only make sense on Android; including them everywhere would let
# e.g. a macOS HOME grow a stray ~/storage/dcim folder that outranks ~/Movies.
if IS_ANDROID:
    _android_dirs = [
        Path("/storage/emulated/0/DCIM") / GALLERY_SUBDIR,  # shared DCIM (gallery)
        Path("/sdcard/DCIM") / GALLERY_SUBDIR,              # alias of the above
        Path.home() / "storage" / "dcim" / GALLERY_SUBDIR,  # Termux symlink
    ]
    _fallback_dirs = [
        Path.home() / "storage" / "downloads",
        Path.home() / "Downloads",
    ]
else:
    _android_dirs = []
    _fallback_dirs = [Path.home() / "Downloads"]

DOWNLOAD_DIRS = [
    *_android_dirs,
    *_desktop_dirs,        # macOS ~/Movies, Linux/Windows ~/Videos
    *_fallback_dirs,       # last resort
]

# Folders that count as "the gallery" for the media-scanner path. On Android
# that is DCIM (Gallery app); on desktop it is the video folder (Photos/TV app).
GALLERY_BASES = list(_android_dirs) + ([] if IS_ANDROID else list(_desktop_dirs))


def _norm(path) -> Path:
    """Absolute, symlink-free best effort - tolerates not-yet-created paths.

    `Path.resolve()` on a missing path is fine on POSIX but raises on Windows
    and can produce different spellings across platforms (e.g. /tmp vs
    /private/tmp on macOS), which would make directory comparisons unreliable.
    """
    try:
        return Path(path).expanduser().resolve()
    except OSError:
        try:
            return Path(os.path.abspath(os.path.expanduser(str(path))))
        except OSError:
            return Path(path)


def is_gallery_dir(path) -> bool:
    """True if `path` is (inside) a system gallery/video folder."""
    p = _norm(path)
    for base in GALLERY_BASES:
        b = _norm(base)
        if p == b or b in p.parents:
            return True
    return False


def _writable(path) -> bool:
    """Writable check that also accepts a folder we could create ourselves."""
    try:
        if path.is_dir():
            return os.access(path, os.W_OK)
    except OSError:
        return False
    # Not there yet: usable if the nearest existing ancestor is writable.
    for parent in path.parents:
        try:
            if parent.is_dir():
                return os.access(parent, os.W_OK)
        except OSError:
            continue
    return False


def find_download_dir() -> Path:
    """First writable destination, preferring the gallery/video folder.

    The gallery folder is the point of this tool, so an existing one wins
    outright. Otherwise we create the preferred gallery folder when its parent
    allows it, and only then fall back to a plain downloads folder - so macOS
    lands in ~/Movies/ytdlmux and Linux in ~/Videos/ytdlmux rather than
    quietly filling ~/Downloads.
    """
    # 1. An already-existing gallery folder wins.
    for cand in GALLERY_BASES:
        try:
            if cand.is_dir() and os.access(cand, os.W_OK):
                return cand
        except OSError:
            continue
    # 2. Create the preferred gallery folder if we may.
    for cand in GALLERY_BASES:
        if not _writable(cand):
            continue
        try:
            cand.mkdir(parents=True, exist_ok=True)
            if os.access(cand, os.W_OK):
                return cand
        except OSError:
            continue
    # 3. Any other existing writable folder (-o target, ~/Downloads, ...).
    for cand in DOWNLOAD_DIRS:
        if cand in GALLERY_BASES:
            continue
        try:
            if cand.is_dir() and os.access(cand, os.W_OK):
                return cand
        except OSError:
            continue
    # 4. Nothing suitable: create a fallback folder.
    for cand in DOWNLOAD_DIRS:
        if cand in GALLERY_BASES or not _writable(cand):
            continue
        try:
            cand.mkdir(parents=True, exist_ok=True)
            return cand
        except OSError:
            continue
    return Path.home()


def fmt_bytes(n) -> str:
    if not n:
        return "?"
    n = float(n)
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return f"{n:.1f} {unit}" if unit != "B" else f"{int(n)} B"
        n /= 1024
    return "?"


def fmt_dur(sec) -> str:
    try:
        sec = int(float(sec))
    except (TypeError, ValueError):
        return "?"
    h, rem = divmod(sec, 3600)
    m, s = divmod(rem, 60)
    return f"{h}:{m:02d}:{s:02d}" if h else f"{m}:{s:02d}"


def fmt_eta(sec) -> str:
    try:
        sec = int(float(sec))
    except (TypeError, ValueError):
        return "--:--"
    if sec < 0:
        return "--:--"
    h, rem = divmod(sec, 3600)
    m, s = divmod(rem, 60)
    return f"{h}:{m:02d}:{s:02d}" if h else f"{m:02d}:{s:02d}"


def fmt_views(v) -> str:
    if not v:
        return ""
    for unit, div in (("B", 10 ** 9), ("M", 10 ** 6), ("K", 10 ** 3)):
        if v >= div:
            return f"{v / div:.1f}{unit} views"
    return f"{v} views"


def human_int(v) -> str:
    return f"{v:,}".replace(",", ".")


