#  downloader with live TUI
# --------------------------------------------------------------------------- #

class Downloader:
    def __init__(self, outdir: Path, args):
        self.outdir = outdir
        self.args = args
        self.tasks: dict[str, int] = {}          # key -> rich task id
        self.totals: dict[str, int | None] = {}  # key -> total bytes
        self.done: dict[str, int] = {}           # key -> downloaded bytes
        self.last_speed: dict[str, float] = {}   # key -> last non-null speed
        self.finished_files: list[str] = []      # final outputs (post-processed)
        self.fragments: list[str] = []           # raw stream fragments
        self.current_label = ""
        self.overall_id = None
        self.lock = threading.Lock()
        self.progress = self._make_progress()

    def _make_progress(self) -> Progress:
        return Progress(
            SpinnerColumn(style=ACCENT),
            TextColumn("[bold]{task.description}", table_column=None),
            BarColumn(bar_width=None, complete_style=ACCENT,
                      finished_style=OK, pulse_style=ACCENT),
            DownloadColumn(),
            SpeedColumn(),
            EtaColumn(),
            TimeElapsedColumn(),
            expand=True,
            transient=False,
            auto_refresh=False,
        )

    # ---------------- rendering ---------------- #

    def header(self) -> Panel:
        t = Text()
        t.append("  ⬇  dl  ", style=f"bold white on {ACCENT}")
        t.append("   yt-dlp TUI downloader\n", style=f"bold {ACCENT}")
        t.append("  Target   ", style=DIM)
        t.append(f"{self.outdir}\n", style="bold white")
        t.append("  Format   ", style=DIM)
        t.append(f"{self.current_label or '-'}\n", style=f"bold {OK}")
        t.append("  Done     ", style=DIM)
        t.append(f"{len(self.finished_files)} file", style="bold white")
        return Panel(t, border_style=ACCENT, box=box.ROUNDED, padding=(0, 1))

    def render(self):
        return Group(self.header(), self.progress.get_renderable())

    # ---------------- progress plumbing ---------------- #

    def _key(self, d) -> tuple[str, str]:
        info = d.get("info_dict") or {}
        key = f"{info.get('id', '?')}:{info.get('format_id', '?')}"
        # human label: resolution for video, bitrate for audio
        res = info.get("resolution")
        height = info.get("height")
        if res and res != "audio only":
            label = res
        elif height:
            label = f"{height}p"
        else:
            abr = info.get("abr")
            label = f"audio {int(abr)}k" if abr else "audio"
        fps = info.get("fps")
        if fps and fps >= 50 and height:
            label = f"{height}p{int(fps)}"
        vcodec = info.get("vcodec") or ""
        acodec = info.get("acodec") or ""
        kind = "🎬" if vcodec not in ("", "none") else "🎵"
        return key, f"{kind} {label}"

    def _overall_totals(self):
        known = [t for t in self.totals.values() if t]
        total = sum(known) if known and len(known) == len(self.totals) else None
        return sum(self.done.values()), total

    def hook(self, d):
        with self.lock:
            status = d.get("status")
            key, note = self._key(d)

            if status == "downloading":
                if key not in self.tasks:
                    self.tasks[key] = self.progress.add_task(
                        f"{note}", total=None, speed=None, eta=None)
                total = d.get("total_bytes") or d.get("total_bytes_estimate")
                self.totals[key] = total
                self.done[key] = d.get("downloaded_bytes") or 0
                speed = d.get("speed")
                if speed:
                    self.last_speed[key] = speed
                self.progress.update(
                    self.tasks[key],
                    total=total,
                    completed=self.done[key],
                    speed=speed or self.last_speed.get(key),
                    eta=d.get("eta"),
                    refresh=False,
                )
            elif status == "finished":
                if key in self.tasks:
                    total = self.totals.get(key) or d.get("total_bytes") or self.done.get(key)
                    self.done[key] = total or self.done.get(key, 0)
                    self.progress.update(
                        self.tasks[key], total=total, completed=total,
                        speed=self.last_speed.get(key), eta=0, refresh=False)
                fname = d.get("filename")
                if fname:
                    self.fragments.append(fname)

            done, total = self._overall_totals()
            if self.overall_id is not None:
                self.progress.update(self.overall_id, completed=done, total=total,
                                     refresh=False)

    def pp_hook(self, d):
        with self.lock:
            status = d.get("status")
            name = d.get("postprocessor") or "post-process"
            if status == "started":
                if self.overall_id is not None:
                    self.progress.update(self.overall_id,
                                         description=f"⚙ {name}…", refresh=False)
            elif status == "finished":
                # Merger / MoveFiles / FFmpegExtractAudio produce the final file
                if name in ("Merger", "MoveFiles", "FFmpegExtractAudio",
                            "Metadata", "EmbedSubtitle", "FFmpegVideoRemuxer",
                            "FFmpegVideoConvertor"):
                    info = d.get("info_dict") or {}
                    path = (d.get("filepath") or info.get("filepath")
                            or info.get("_filename") or info.get("filename"))
                    if path and path not in self.finished_files:
                        self.finished_files.append(path)

    # ---------------- the actual run ---------------- #

    def download(self, url, selector, postprocessors) -> bool:
        from yt_dlp import YoutubeDL

        logger = RichLogger()
        outtmpl = str(self.outdir / "%(title)s.%(ext)s")

        opts = {
            "format": selector,
            "outtmpl": outtmpl,
            "merge_output_format": "mp4",
            "noplaylist": not self.args.playlist,
            "playlist_items": self.args.playlist_items,
            "ignoreerrors": bool(self.args.playlist),
            "continuedl": True,
            "overwrites": False,
            "retries": 10,
            "fragment_retries": 10,
            "socket_timeout": 30,
            "concurrent_fragment_downloads": 4,
            "noprogress": True,
            "quiet": True,
            "no_warnings": False,
            "logger": logger,
            "progress_hooks": [self.hook],
            "postprocessor_hooks": [self.pp_hook],
            "consoletitle": False,
            "trim_file_name": 200,
            "windowsfilenames": False,
        }
        rt = js_runtimes()
        if rt:
            opts["js_runtimes"] = rt
        if postprocessors:
            opts["postprocessors"] = postprocessors
        if self.args.sub:
            opts.update({
                "writesubtitles": True,
                "writeautomaticsub": True,
                "subtitleslangs": ["id", "en"],
                "subtitlesformat": "srt/best",
                "embedsubtitles": True,
            })
        if self.args.proxy:
            opts["proxy"] = self.args.proxy
        if self.args.limit_rate:
            opts["ratelimit"] = self.args.limit_rate

        self.progress = self._make_progress()
        self.tasks, self.totals, self.done, self.last_speed = {}, {}, {}, {}
        self.overall_id = self.progress.add_task("TOTAL", total=None, _overall=True)

        ok = True
        started = time.time()
        # NOTE: Live must receive a *callable* (get_renderable), not a snapshot.
        # Passing self.render() here would freeze the display on the first frame
        # while the download raced to completion (bar stuck, file already there).
        with Live(console=console, get_renderable=self.render,
                  refresh_per_second=10, transient=False,
                  vertical_overflow="visible") as live:
            try:
                with YoutubeDL(opts) as ydl:
                    ydl.download([url])
            except KeyboardInterrupt:
                console.print(f"\n[{WARN}]Cancelled by user.[/]")
                ok = False
            except Exception as exc:                              # noqa: BLE001
                console.print(Panel(Text(str(exc), style=BAD),
                                    title="[bold red]Download failed[/]",
                                    border_style=BAD))
                ok = False
            finally:
                self.progress.update(self.overall_id, description="FINISHED",
                                     refresh=False)

        console.print()

        # Recoverable extraction warnings are noisy and yt-dlp usually retries
        # them successfully — only surface diagnostics when something failed.
        if not ok:
            for w in logger.warnings[:3]:
                console.print(f"[{WARN}]⚠ {w}[/]")
            for e in logger.errors[:5]:
                console.print(f"[{BAD}]✖ {e}[/]")

        if ok:
            elapsed = time.time() - started
            files = [f for f in self.finished_files if f]
            if not files:
                # single-format download: no merger ran, use the raw file
                files = [f for f in self.fragments if f]
            # Register the finished files with Android so the Gallery app
            # indexes them (runs in the background; never blocks the TUI).
            existing = [f for f in files if Path(f).exists()]
            in_gallery = is_gallery_dir(self.outdir)
            if in_gallery:
                media_scan(existing)
            body = Text()
            body.append("✔  Download complete\n", style=f"bold {OK}")
            body.append(f"   {len(files) or 1} file · {fmt_dur(elapsed)}\n", style=DIM)
            for f in files[-6:]:
                body.append(f"   {Path(f).name}\n", style="white")
            body.append(f"   → {self.outdir}\n", style=f"bold {ACCENT}")
            if in_gallery:
                body.append("   📱 now visible in your phone's gallery", style=DIM)
            console.print(Panel(body, border_style=OK, box=box.ROUNDED))
        return ok


