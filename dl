# Plain-ASCII "YTDLMUX" wordmark. Kept as a raw string so the box-drawing
# characters survive byte-for-byte; the width is derived rather than hardcoded
# so edits cannot silently misalign the panel.
BANNER = r"""██╗   ██╗████████╗██████╗ ██╗     ███╗   ███╗██╗   ██╗██╗  ██╗
╚██╗ ██╔╝╚══██╔══╝██╔══██╗██║     ████╗ ████║██║   ██║╚██╗██╔╝
 ╚████╔╝    ██║   ██║  ██║██║     ██╔████╔██║██║   ██║ ╚███╔╝
  ╚██╔╝     ██║   ██║  ██║██║     ██║╚██╔╝██║██║   ██║ ██╔██╗
   ██║      ██║   ██████╔╝███████╗██║ ╚═╝ ██║╚██████╔╝██╔╝ ██╗
   ╚═╝      ╚═╝   ╚═════╝ ╚══════╝╚═╝     ╚═╝ ╚═════╝ ╚═╝  ╚═╝"""

BANNER_LINES = BANNER.split("\n")
BANNER_WIDTH = max(len(l) for l in BANNER_LINES)

# Colour ramp painted across the banner, left to right, line by line, so the
# wordmark reads as one gradient instead of six separately-coloured rows.
_GRADIENT = [
    "#22d3ee", "#2dd4bf", "#34d399", "#4ade80", "#a3e635", "#facc15",
    "#fbbf24", "#fb923c", "#f87171", "#e879f9", "#c084fc", "#a78bfa",
]

def banner_text() -> Text:
    """The YTDLMUX wordmark as an animated-looking colour gradient."""
    out = Text()
    nth = 0
    for line_i, line in enumerate(BANNER_LINES):
        if line_i:
            out.append("\n")
        width = max(len(line), 1)
        for col_i, ch in enumerate(line):
            if ch == " ":
                out.append(" ")
                continue
            # Blend the row into the ramp so wide glyphs step smoothly.
            pos = (col_i / width + line_i / len(BANNER_LINES)) / 2
            colour = _GRADIENT[min(int(pos * len(_GRADIENT)), len(_GRADIENT) - 1)]
            out.append(ch, style=f"bold {colour}")
            nth += 1
    return out

# Half-block glyphs give a smooth fill at any terminal width without needing
# per-cell finesse; the head/tail differ so motion is visible mid-download.
BAR_FULL = "█"
BAR_EMPTY = "─"

def gradient_bar(fraction: float, width: int = 28, done: bool = False) -> Text:
    """A smooth Unicode progress bar with a colour that reflects state.

    Colours are semantic rather than decorative: yellow while transferring,
    green once finished, so the state is readable at a glance even on a
    colourblind-unfriendly terminal.
    """
    fraction = 0.0 if fraction < 0 else (1.0 if fraction > 1 else fraction)
    filled = int(round(fraction * width))
    filled = min(filled, width)
    bar = Text()
    if done:
        bar.append(BAR_FULL * filled, style=f"bold {OK}")
        bar.append(BAR_EMPTY * (width - filled), style="grey35")
    else:
        # Two-tone fill: the leading third in the accent makes length readable
        # without needing to count cells.
        head = max(filled - max(width // 5, 3), 0)
        bar.append(BAR_FULL * head, style=f"bold {ACCENT}")
        bar.append(BAR_FULL * (filled - head), style="bold bright_cyan")
        bar.append(BAR_EMPTY * (width - filled), style="grey35")
    return bar


# --------------------------------------------------------------------------- #
#  downloader with live TUI
# --------------------------------------------------------------------------- #

class Downloader:
    def __init__(self, outdir: Path, args):
        self.outdir = outdir
        self.args = args
        self.tasks: dict[str, int] = {}          # key -> rich task id
        self.totals: dict[str, int | None] = {}  # key -> total bytes
        self.done: dict[str, int] = {}           # key -> downloaded bytes
        self.last_speed: dict[str, float] = {}   # key -> last non-null speed
        self.finished_files: list[str] = []      # final outputs (post-processed)
        self.fragments: list[str] = []           # raw stream fragments
        self.current_label = ""
        self.overall_id = None
        self.lock = threading.Lock()
        self.progress = self._make_progress()

    def _make_progress(self) -> Progress:
        return Progress(
            IconColumn(),
            LabelColumn(),
            SmoothBarColumn(bar_width=24),
            PercentColumn(),
            SizeColumn(),
            SpeedColumn(),
            EtaColumn(),
            SuiteTimeColumn(),
            expand=True,
            transient=False,
            auto_refresh=False,
        )

    # ---------------- rendering ---------------- #

    def _meta_rows(self) -> list[tuple[str, str, str]]:
        """(label, value, value-style) shown under the banner."""
        done = len(self.finished_files)
        rows = [
            ("Target", str(self.outdir), "bold white"),
            ("Format", self.current_label or "-", f"bold {OK}"),
            ("Done", f"{done} file" + ("s" if done != 1 else ""), "bold white"),
        ]
        # Surface the aggregate speed/ETA next to the metadata once we have
        # numbers, so the headline row stays useful at a glance.
        done_b, total_b = self._overall_totals()
        if total_b:
            pct = done_b / total_b * 100 if total_b else 0
            rows.append(("Progress", f"{pct:.1f}%", f"bold {ACCENT}"))
        return rows

    def header(self) -> Panel:
        body = Text()
        # Banner width is fixed by the wordmark; centre it (and the credit
        # line) against it so the block looks deliberate at any terminal size.
        pad = " " * 2
        banner = banner_text()
        for i, line in enumerate(banner.split("\n")):
            if i:
                body.append("\n")
            body.append(pad)
            body.append_text(line)
        body.append("\n")
        credit = Text("dev by ", style=DIM)
        credit.append("Qintomb", style=f"bold {ACCENT}")
        credit.append("   ·   ", style="grey35")
        credit.append(f"v{VERSION}", style=f"bold {WARN}")
        credit.append("   ·   ", style="grey35")
        credit.append("yt-dlp TUI downloader", style=DIM)
        body.append(" " * max((BANNER_WIDTH - len(credit.plain)) // 2 + 2, 2))
        body.append_text(credit)
        body.append("\n\n")

        width = max(len(s) for s, _, _ in self._meta_rows()) + 2
        for label, value, vstyle in self._meta_rows():
            body.append(f"  {label:<{width}}", style=DIM)
            body.append(f"{value}\n", style=vstyle)
        return Panel(body, border_style=ACCENT, box=box.ROUNDED, padding=(0, 1))

    def render(self):
        return Group(self.header(), self.progress.get_renderable())

    # ---------------- progress plumbing ---------------- #

    def _key(self, d) -> tuple[str, str]:
        info = d.get("info_dict") or {}
        key = f"{info.get('id', '?')}:{info.get('format_id', '?')}"
        # human label: resolution for video, bitrate for audio
        res = info.get("resolution")
        height = info.get("height")
        if res and res != "audio only":
            label = res
        elif height:
            label = f"{height}p"
        else:
            abr = info.get("abr")
            label = f"audio {int(abr)}k" if abr else "audio"
        fps = info.get("fps")
        if fps and fps >= 50 and height:
            label = f"{height}p{int(fps)}"
        vcodec = info.get("vcodec") or ""
        acodec = info.get("acodec") or ""
        kind = "🎬" if vcodec not in ("", "none") else "🎵"
        return key, f"{kind} {label}"

    def _overall_totals(self):
        known = [t for t in self.totals.values() if t]
        total = sum(known) if known and len(known) == len(self.totals) else None
        return sum(self.done.values()), total

    def hook(self, d):
        with self.lock:
            status = d.get("status")
            key, note = self._key(d)

            if status == "downloading":
                self._spin = getattr(self, "_spin", 0) + 1
                if self.overall_id is not None:
                    self.progress.update(self.overall_id,
                                         _spin=self._spin, refresh=False)
                if key not in self.tasks:
                    self.tasks[key] = self.progress.add_task(
                        f"{note}", total=None, speed=None, eta=None)
                total = d.get("total_bytes") or d.get("total_bytes_estimate")
                self.totals[key] = total
                self.done[key] = d.get("downloaded_bytes") or 0
                speed = d.get("speed")
                if speed:
                    self.last_speed[key] = speed
                self.progress.update(
                    self.tasks[key],
                    total=total,
                    completed=self.done[key],
                    speed=speed or self.last_speed.get(key),
                    eta=d.get("eta"),
                    refresh=False,
                )
            elif status == "finished":
                if key in self.tasks:
                    total = self.totals.get(key) or d.get("total_bytes") or self.done.get(key)
                    self.done[key] = total or self.done.get(key, 0)
                    self.progress.update(
                        self.tasks[key], total=total, completed=total,
                        speed=self.last_speed.get(key), eta=0, refresh=False)
                fname = d.get("filename")
                if fname:
                    self.fragments.append(fname)

            done, total = self._overall_totals()
            if self.overall_id is not None:
                self.progress.update(self.overall_id, completed=done, total=total,
                                     refresh=False)

    def pp_hook(self, d):
        with self.lock:
            status = d.get("status")
            name = d.get("postprocessor") or "post-process"
            if status == "started":
                if self.overall_id is not None:
                    self.progress.update(self.overall_id,
                                         description=f"⚙ {name}…", refresh=False)
            elif status == "finished":
                # Merger / MoveFiles / FFmpegExtractAudio produce the final file
                if name in ("Merger", "MoveFiles", "FFmpegExtractAudio",
                            "Metadata", "EmbedSubtitle", "FFmpegVideoRemuxer",
                            "FFmpegVideoConvertor"):
                    info = d.get("info_dict") or {}
                    path = (d.get("filepath") or info.get("filepath")
                            or info.get("_filename") or info.get("filename"))
                    if path and path not in self.finished_files:
                        self.finished_files.append(path)

    # ---------------- the actual run ---------------- #

    def download(self, url, selector, postprocessors) -> bool:
        from yt_dlp import YoutubeDL

        logger = RichLogger()
        outtmpl = str(self.outdir / "%(title)s.%(ext)s")

        opts = {
            "format": selector,
            "outtmpl": outtmpl,
            "merge_output_format": "mp4",
            "noplaylist": not self.args.playlist,
            "playlist_items": self.args.playlist_items,
            "ignoreerrors": bool(self.args.playlist),
            "continuedl": True,
            "overwrites": False,
            "retries": 10,
            "fragment_retries": 10,
            "socket_timeout": 30,
            "concurrent_fragment_downloads": 4,
            "noprogress": True,
            "quiet": True,
            "no_warnings": False,
            "logger": logger,
            "progress_hooks": [self.hook],
            "postprocessor_hooks": [self.pp_hook],
            "consoletitle": False,
            "trim_file_name": 200,
            "windowsfilenames": False,
        }
        rt = js_runtimes()
        if rt:
            opts["js_runtimes"] = rt
        if postprocessors:
            opts["postprocessors"] = postprocessors
        if self.args.sub:
            opts.update({
                "writesubtitles": True,
                "writeautomaticsub": True,
                "subtitleslangs": ["id", "en"],
                "subtitlesformat": "srt/best",
                "embedsubtitles": True,
            })
        if self.args.proxy:
            opts["proxy"] = self.args.proxy
        if self.args.limit_rate:
            opts["ratelimit"] = self.args.limit_rate

        self.progress = self._make_progress()
        self.tasks, self.totals, self.done, self.last_speed = {}, {}, {}, {}
        self.overall_id = self.progress.add_task("TOTAL", total=None, _overall=True)

        ok = True
        started = time.time()
        # NOTE: Live must receive a *callable* (get_renderable), not a snapshot.
        # Passing self.render() here would freeze the display on the first frame
        # while the download raced to completion (bar stuck, file already there).
        with Live(console=console, get_renderable=self.render,
                  refresh_per_second=10, transient=False,
                  vertical_overflow="visible") as live:
            try:
                with YoutubeDL(opts) as ydl:
                    ydl.download([url])
            except KeyboardInterrupt:
                console.print(f"\n[{WARN}]Cancelled by user.[/]")
                ok = False
            except Exception as exc:                              # noqa: BLE001
                console.print(Panel(Text(str(exc), style=BAD),
                                    title="[bold red]Download failed[/]",
                                    border_style=BAD))
                ok = False
            finally:
                self.progress.update(self.overall_id, description="FINISHED",
                                     refresh=False)

        console.print()

        # Recoverable extraction warnings are noisy and yt-dlp usually retries
        # them successfully — only surface diagnostics when something failed.
        if not ok:
            for w in logger.warnings[:3]:
                console.print(f"[{WARN}]⚠ {w}[/]")
            for e in logger.errors[:5]:
                console.print(f"[{BAD}]✖ {e}[/]")

        if ok:
            elapsed = time.time() - started
            files = [f for f in self.finished_files if f]
            if not files:
                # single-format download: no merger ran, use the raw file
                files = [f for f in self.fragments if f]
            # Register the finished files with Android so the Gallery app
            # indexes them (runs in the background; never blocks the TUI).
            existing = [f for f in files if Path(f).exists()]
            in_gallery = is_gallery_dir(self.outdir)
            if in_gallery:
                media_scan(existing)
            body = Text()
            body.append("  ✔  ", style=f"bold {OK}")
            body.append("Download complete\n", style=f"bold {OK}")
            body.append("     ", style="")
            body.append(f"{len(files) or 1} file", style="bold white")
            body.append("  ·  ", style="grey35")
            body.append(f"{fmt_dur(elapsed)}\n", style=DIM)
            body.append("\n")
            for f in files[-6:]:
                body.append("     ▸ ", style=f"bold {ACCENT}")
                body.append(f"{Path(f).name}\n", style="white")
            body.append("\n")
            body.append("     → ", style=DIM)
            body.append(f"{self.outdir}\n", style=f"bold {ACCENT}")
            if in_gallery:
                where = ("your phone's gallery" if IS_ANDROID
                         else "your video folder")
                body.append(f"     📱 saved to {where}", style=DIM)
            console.print(Panel(body, border_style=OK, box=box.ROUNDED,
                                padding=(1, 1)))
        return ok


# --------------------------------------------------------------------------- #
#  termux integration
# --------------------------------------------------------------------------- #

def termux(cmd: list[str], timeout: int = 6):
    if not shutil.which(cmd[0]):
        return None
    try:
        return subprocess.run(cmd, capture_output=True, text=True,
                              timeout=timeout, check=False).stdout
    except Exception:                                             # noqa: BLE001
        return None


def _clipboard_text() -> str | None:
    """Raw clipboard contents, using whatever the host OS provides.

    Terminal emulators (Ghostty, iTerm, Windows Terminal, ...) have no shared
    clipboard library, so we shell out to the platform-native tool. Termux:API
    is tried first on Android; everything else degrades to None, which simply
    means "no clipboard support" rather than an error.
    """
    candidates: list[list[str]] = []
    if IS_ANDROID:
        if termux_api_available():
            candidates.append(["termux-clipboard-get"])
    elif IS_MAC:
        candidates.append(["pbpaste"])
    elif IS_WIN:
        # PowerShell's Get-Clipboard works on Windows 10+ without extra tools.
        for shell in ("powershell", "pwsh"):
            if shutil.which(shell):
                candidates.append([shell, "-NoProfile", "-Command", "Get-Clipboard"])
    else:
        # Wayland first, then X11 — cover whichever session is actually running.
        if os.environ.get("WAYLAND_DISPLAY"):
            candidates.extend([["wl-paste", "--no-newline"], ["wl-paste"]])
        candidates.extend([["xclip", "-selection", "clipboard", "-o"],
                           ["xsel", "--clipboard", "--output"]])

    for cmd in candidates:
        out = termux(cmd)
        if out and out.strip():
            return out
    return None


def clipboard_supported() -> bool:
    """Does this environment have any working clipboard reader?

    Used only to tailor the error message — `dl` never fails hard on a missing
    clipboard, it just asks for an explicit URL instead.
    """
    if IS_ANDROID:
        return termux_api_available() and bool(shutil.which("termux-clipboard-get"))
    if IS_MAC:
        return bool(shutil.which("pbpaste"))
    if IS_WIN:
        return bool(shutil.which("pwsh") or shutil.which("powershell"))
    if os.environ.get("WAYLAND_DISPLAY") and shutil.which("wl-paste"):
        return True
    return bool(shutil.which("xclip") or shutil.which("xsel"))


def clipboard_url() -> str | None:
    out = _clipboard_text()
    if not out:
        return None
    for token in out.split():
        if token.startswith("http://") or token.startswith("https://"):
            return token.strip()
    return None


def _notify_cmd(title: str, content: str) -> list[str] | None:
    """Best available native notification command for this OS, or None."""
    if IS_ANDROID:
        if termux_api_available() and shutil.which("termux-notification"):
            return ["termux-notification", "--title", title,
                    "--content", content, "--priority", "low"]
        return None
    if IS_MAC:
        # osascript is always present on macOS; escape quotes/backslashes.
        t = title.replace("\\", "\\\\").replace('"', '\\"')
        c = content.replace("\\", "\\\\").replace('"', '\\"')
        return ["osascript", "-e",
                f'display notification "{c}" with title "{t}"']
    if IS_WIN:
        ps = ("[reflection.assembly]::LoadWithPartialName('System.Windows.Forms');"
              "$n=New-Object System.Windows.Forms.NotifyIcon;"
              "$n.Icon=[System.Drawing.SystemIcons]::Information;"
              "$n.Visible=$true;"
              f"$n.ShowBalloonTip(5000,'{title}','{content}',0);"
              "Start-Sleep -Seconds 6;$n.Dispose()")
        shell = shutil.which("pwsh") or shutil.which("powershell")
        return [shell, "-NoProfile", "-WindowStyle", "Hidden", "-Command", ps] if shell else None
    if shutil.which("notify-send"):
        return ["notify-send", "-a", "ytdlmux", title, content]
    return None


def notify(title: str, content: str):
    """Fire a desktop/Android notification (never blocks the TUI)."""
    cmd = _notify_cmd(title, content)
    if not cmd:
        return
    threading.Thread(
        target=lambda: termux(cmd, timeout=8),
        daemon=True,
    ).start()


def wake_lock(on: bool):
    """Keep the CPU awake during a download (Android only; no-op elsewhere).

    Desktops have no equivalent — and none is needed, since they do not suspend
    background processes the way Android does.
    """
    if not IS_ANDROID or not termux_api_available():
        return
    termux(["termux-wake-lock"] if on else ["termux-wake-unlock"])


# --------------------------------------------------------------------------- #
#  media scanner — make finished files visible in the Android Gallery
# --------------------------------------------------------------------------- #

_TERMUX_API_OK: bool | None = None


def termux_api_available() -> bool:
    """Is the Termux:API app installed?

    Without it, every termux-api command (termux-media-scan, termux-toast, ...)
    blocks forever waiting for a reply that never comes. We therefore probe the
    package list first — that check returns in well under a second.
    """
    global _TERMUX_API_OK
    if _TERMUX_API_OK is not None:
        return _TERMUX_API_OK
    _TERMUX_API_OK = False
    if shutil.which("pm"):
        try:
            out = subprocess.run(["pm", "list", "packages", "com.termux.api"],
                                 capture_output=True, text=True, timeout=5,
                                 check=False).stdout
            _TERMUX_API_OK = "com.termux.api" in (out or "")
        except Exception:                                         # noqa: BLE001
            _TERMUX_API_OK = False
    return _TERMUX_API_OK


def _scan_paths(paths: list[str]) -> None:
    """Tell the OS about new files so gallery apps pick them up (best effort).

    Android needs an explicit scan. Desktops do not: macOS and Linux video
    folders and the Windows Videos library are enumerated live by their
    gallery apps, so this is deliberately a no-op there.
    """
    if not paths:
        return
    if not IS_ANDROID:
        return
    if termux_api_available() and shutil.which("termux-media-scan"):
        termux(["termux-media-scan", *paths], timeout=20)
        return
    # No Termux:API app -> ask the activity manager directly. The "--user 0"
    # part matters: without it Android rejects the broadcast for this uid.
    am = "/system/bin/am" if os.path.exists("/system/bin/am") else shutil.which("am")
    if not am:
        return
    for p in paths:
        try:
            subprocess.run(
                [am, "broadcast", "--user", "0",
                 "-a", "android.intent.action.MEDIA_SCANNER_SCAN_FILE",
                 "-d", f"file://{p}"],
                capture_output=True, text=True, timeout=15, check=False)
        except Exception:                                         # noqa: BLE001
            continue


def media_scan(paths: list[str], wait: float = 8.0) -> None:
    """Index downloaded files so the OS gallery app shows them.

    Runs in a daemon thread so a slow/absent media scanner can never stall the
    TUI, but we still join briefly (default 8s) so the usual case finishes
    before the process exits. The scan itself is best effort.
    """
    paths = [str(p) for p in paths if p]
    if not paths:
        return
    t = threading.Thread(target=_scan_paths, args=(paths,), daemon=True)
    t.start()
    try:
        t.join(timeout=wait)
    except KeyboardInterrupt:                                     # noqa: BLE001
        pass


# --------------------------------------------------------------------------- #
#  self-update (dl -U) — pulls the latest GitHub release, not just yt-dlp
# --------------------------------------------------------------------------- #

def _http_get(url: str, timeout: int = 15) -> str:
    req = urllib.request.Request(
        url, headers={"User-Agent": f"ytdlmux/{VERSION}",
                      "Accept": "application/vnd.github+json"})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return resp.read().decode("utf-8", "replace")


def _latest_release_tag() -> str | None:
    """Newest release tag on GitHub, or None when offline / rate-limited."""
    try:
        import json
        data = json.loads(_http_get(GITHUB_API))
        return (data.get("tag_name") or "").strip() or None
    except Exception:                                             # noqa: BLE001
        return None


def _version_key(tag: str) -> tuple:
    """'v1.2.3' / '1.2.3' -> (1, 2, 3), so tags compare numerically."""
    parts = tag.lstrip("vV").split(".")
    out = []
    for p in parts:
        num = "".join(ch for ch in p if ch.isdigit())
        out.append(int(num) if num else 0)
    return tuple(out) or (0,)


def _looks_like_dl(body: str) -> bool:
    """Cheap sanity check that we fetched the real dl script, not an error page.

    An HTML error page or a 404 body would otherwise overwrite a working
    install; requiring our marker strings makes that impossible.
    """
    return ("VERSION = " in body
            and "GITHUB_REPO = " in body
            and "def self_update" in body)


def _installed_script_path() -> Path | None:
    """Real path of this running script (resolving the `dl` on PATH)."""
    for candidate in (Path(__file__), Path(sys.argv[0])):
        try:
            if candidate and candidate.exists():
                return candidate.resolve()
        except OSError:
            continue
    found = shutil.which("dl")
    return Path(found).resolve() if found else None


def _keep_shebang(path: Path, new_text: str) -> str:
    """Carry the installed script's interpreter over to the downloaded body.

    This matters for venv installs: the local shebang points at the venv's
    python (which has rich/prompt_toolkit/yt-dlp). The upstream file ships a
    generic `#!/usr/bin/env python3`, so blindly writing it would silently move
    the user back to a system interpreter — on macOS that is Python 3.9, whose
    yt-dlp cannot extract YouTube any more. Installation-specific first lines
    therefore win over the upstream default.
    """
    try:
        current = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return new_text
    old_shebang = current.split("\n", 1)[0].strip()
    if not old_shebang.startswith("#!"):
        return new_text

    lines = new_text.split("\n")
    if not lines or not lines[0].startswith("#!"):
        return new_text

    # If upstream already points at a specific interpreter, trust it; only
    # replace the generic `env python3` form, which is the one that loses the
    # venv/version. A pinned /usr/bin/python3.9 from upstream would be a
    # deliberate choice we should not silently rewrite either.
    if "env python" not in lines[0]:
        return new_text
    if old_shebang == "#!/usr/bin/env python3":
        return new_text
    lines[0] = old_shebang
    return "\n".join(lines)


def _replace_running_script(path: Path, new_text: str) -> bool:
    """Atomically swap the installed script, preserving its mode bit."""
    try:
        mode = path.stat().st_mode
    except OSError:
        mode = 0o755
    # Preserve the interpreter this install actually uses (see docstring).
    new_text = _keep_shebang(path, new_text)
    try:
        # Write beside the target so os.replace stays on one filesystem
        # (a cross-device rename would fail); then swap atomically.
        fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=".dl-", suffix=".tmp")
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(new_text)
        os.chmod(tmp, mode & 0o777)
        os.replace(tmp, path)
        return True
    except OSError as exc:
        # Most likely a read-only location (e.g. /usr/bin); tell the user how
        # to fix it instead of silently leaving a half-updated script.
        console.print(f"[{WARN}]⚠ Could not write {path}: {exc}[/]")
        console.print(f"[{DIM}]  Re-run with elevated rights, or install "
                      f"somewhere user-writable (e.g. ~/.local/bin).[/]")
        return False


def _python_too_old() -> bool:
    """True when running on a Python older than what yt-dlp fully supports.

    yt-dlp still runs on 3.9 but has deprecated it, and newer YouTube
    extraction paths break there ("The page needs to be reloaded" surfaces this
    way). Warning early turns a confusing failure into an actionable message.
    """
    return sys.version_info < (3, 10)


def _other_pythons() -> list[str]:
    """Newer python interpreters on PATH that could run dl instead."""
    found = []
    for minor in range(10, 15):
        exe = shutil.which(f"python3.{minor}")
        if exe:
            found.append(f"python3.{minor}")
    return found


def _python_hint() -> str:
    """Short, per-OS hint for getting a newer Python."""
    if IS_ANDROID:
        return "pkg install python   (then re-run: pip install -U yt-dlp)"
    if IS_MAC:
        return "brew install python@3.12   (then reinstall yt-dlp for it)"
    if IS_WIN:
        return "winget install Python.Python.3.12"
    return "sudo apt install python3.12   (or your distro's newer python3)"


def _ytdlp_version() -> str | None:
    """Installed yt-dlp version, or None when unavailable."""
    try:
        import yt_dlp
        return yt_dlp.version.__version__
    except Exception:                                             # noqa: BLE001
        return None


def _latest_pypi_version(pkg: str = "yt-dlp") -> str | None:
    """Newest version on PyPI, used to report yt-dlp status without pip noise."""
    try:
        import json
        data = json.loads(_http_get(f"https://pypi.org/pypi/{pkg}/json", timeout=15))
        return (data.get("info") or {}).get("version")
    except Exception:                                             # noqa: BLE001
        return None


def _in_venv() -> bool:
    """True when running inside a virtualenv (sys.prefix != base prefix)."""
    return (sys.prefix != getattr(sys, "base_prefix", sys.prefix)
            or bool(os.environ.get("VIRTUAL_ENV")))


def _pep668_hint(stderr: str) -> str | None:
    """Explain pip's externally-managed-environment refusal, if that is it.

    Homebrew/Debian mark their Python as externally managed (PEP 668) and
    refuse system-wide installs. That is a deliberate safety feature, so the
    fix is a virtualenv or pipx — never --break-system-packages.
    """
    if "externally-managed-environment" not in stderr:
        return None
    venv_dir = Path.home() / ".local" / "share" / "ytdlmux" / "venv"
    py = Path(sys.executable).name
    return ("This Python is externally managed (PEP 668).\n"
            f"       [{DIM}]Do NOT use --break-system-packages.[/]\n"
            f"       [{DIM}]Install ytdlmux into its own venv instead:[/]\n"
            f"       [{DIM}]  {py} -m venv {venv_dir}[/]\n"
            f"       [{DIM}]  {venv_dir}/bin/pip install -U yt-dlp rich "
            f"prompt_toolkit[/]\n"
            f"       [{DIM}]  then run dl via {venv_dir}/bin/python[/]")


def update_ytdlp() -> tuple[bool, str]:
    """Upgrade yt-dlp via pip. Returns (ok, human summary).

    Reporting note: pip's own output is silenced because it interleaves with the
    rich TUI; we only surface a short verdict.
    """
    before = _ytdlp_version()
    cmd = [sys.executable, "-m", "pip", "install", "-U", "--quiet", "yt-dlp"]
    # A venv/--user target needs no special flags; a global one may be locked
    # down by the OS, in which case pip reports it and we explain below.
    if not _in_venv():
        cmd.append("--user")
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=600)
        if proc.returncode != 0:
            blob = (proc.stderr or "") + (proc.stdout or "")
            hint = _pep668_hint(blob)
            if hint:
                return False, hint
            detail = blob.strip().splitlines()
            return False, detail[-1] if detail else f"pip exited {proc.returncode}"
    except Exception as exc:                                      # noqa: BLE001
        return False, str(exc)

    after = _ytdlp_version()
    if before and after and _version_key(after) > _version_key(before):
        return True, f"{before} → {after}"
    if after:
        return True, f"{after} (already latest)"
    return True, "updated"


def self_update(assume_yes: bool = False) -> int:
    """`dl -U`: check and update BOTH yt-dlp and ytdlmux.

    Two independent checks:

      1. yt-dlp  — upgraded through pip (issues a deprecation warning on 3.9).
      2. ytdlmux — compared against the latest GitHub *release* tag, then the
                   script itself is replaced in place. No re-clone needed.

    Only the `dl` script is fetched; nothing else in the repo is touched, so a
    git checkout at any commit still updates cleanly.
    """
    rc = 0
    console.print(f"[bold {ACCENT}]Checking for updates[/]  "
                  f"[{DIM}](ytdlmux v{VERSION})[/]")

    # ---- 1/2  yt-dlp -----------------------------------------------------
    cur_ytdlp = _ytdlp_version()
    console.print(f"  [1/2] yt-dlp       [{DIM}]installed: {cur_ytdlp or 'not installed'}[/]")
    latest_ytdlp = _latest_pypi_version()
    if latest_ytdlp:
        console.print(f"       {'':9} [{DIM}]latest:    {latest_ytdlp}[/]")

    if cur_ytdlp and latest_ytdlp and _version_key(latest_ytdlp) <= _version_key(cur_ytdlp):
        console.print(f"       [{OK}]✔ yt-dlp is up to date[/]")
    else:
        console.print(f"       [{ACCENT}]→ updating yt-dlp…[/]")
        ok, summary = update_ytdlp()
        if ok:
            console.print(f"       [{OK}]✔ yt-dlp {summary}[/]")
        else:
            console.print(f"       [{WARN}]⚠ yt-dlp update failed: {summary}[/]")
            console.print(f"       [{DIM}]  try manually: "
                          f"{Path(sys.executable).name} -m pip install -U yt-dlp[/]")
            rc = 1

    # ---- 2/2  ytdlmux itself ---------------------------------------------
    console.print(f"  [2/2] ytdlmux      [{DIM}]installed: v{VERSION}[/]")
    tag = _latest_release_tag()
    if not tag:
        console.print(f"       [{DIM}]could not reach GitHub — script left as is[/]")
        if rc == 0:
            console.print(f"\n[{OK}]Done.[/]")
        return rc

    console.print(f"       {'':9} [{DIM}]latest:    {tag}[/]")

    if _version_key(tag) <= _version_key(VERSION):
        console.print(f"       [{OK}]✔ ytdlmux is up to date[/]")
        console.print(f"\n[{OK}]Done.[/]")
        return rc

    path = _installed_script_path()
    if not path:
        console.print(f"       [{WARN}]⚠ cannot locate the running dl script[/]")
        return rc

    console.print(f"       [{ACCENT}]→ downloading {tag}…[/]")
    # Try the release tag first; fall back to main so a tag without the file
    # (or a newly created release) still upgrades.
    for url in (f"{GITHUB_RAW}/{tag}/dl", f"{GITHUB_RAW}/main/dl"):
        try:
            body = _http_get(url, timeout=20)
        except Exception:                                         # noqa: BLE001
            continue
        if not body.lstrip().startswith("#!"):
            continue                                              # sanity check
        if not _looks_like_dl(body):
            console.print(f"       [{WARN}]⚠ downloaded file is not the dl script; skipped[/]")
            continue
        if _replace_running_script(path, body):
            console.print(f"       [{OK}]✔ ytdlmux updated v{VERSION} → {tag}[/]")
            console.print(f"       [{DIM}]  {path}[/]")
            console.print(f"       [{DIM}]  restart dl to use the new version[/]")
        else:
            rc = 1
        break
    else:
        console.print(f"       [{WARN}]⚠ download of {tag} failed; script unchanged[/]")
        rc = 1

    if rc == 0:
        console.print(f"\n[{OK}]Update complete.[/]")
    return rc


