def termux(cmd: list[str], timeout: int = 6):
    if not shutil.which(cmd[0]):
        return None
    try:
        return subprocess.run(cmd, capture_output=True, text=True,
                              timeout=timeout, check=False).stdout
    except Exception:                                             # noqa: BLE001
        return None


def clipboard_url() -> str | None:
    if not termux_api_available():
        return None
    out = termux(["termux-clipboard-get"])
    if not out:
        return None
    for token in out.split():
        if token.startswith("http://") or token.startswith("https://"):
            return token.strip()
    return None


def notify(title: str, content: str):
    if not termux_api_available() or not shutil.which("termux-notification"):
        return
    threading.Thread(
        target=lambda: termux(
            ["termux-notification", "--title", title, "--content", content,
             "--priority", "low"], timeout=6),
        daemon=True,
    ).start()


def wake_lock(on: bool):
    """Keep the CPU awake during a download (no-op without Termux:API)."""
    if not termux_api_available():
        return
    termux(["termux-wake-lock"] if on else ["termux-wake-unlock"])


# --------------------------------------------------------------------------- #
#  media scanner — make finished files visible in the Android Gallery
# --------------------------------------------------------------------------- #

_TERMUX_API_OK: bool | None = None


def termux_api_available() -> bool:
    """Is the Termux:API app installed?

    Without it, every termux-api command (termux-media-scan, termux-toast, ...)
    blocks forever waiting for a reply that never comes. We therefore probe the
    package list first — that check returns in well under a second.
    """
    global _TERMUX_API_OK
    if _TERMUX_API_OK is not None:
        return _TERMUX_API_OK
    _TERMUX_API_OK = False
    if shutil.which("pm"):
        try:
            out = subprocess.run(["pm", "list", "packages", "com.termux.api"],
                                 capture_output=True, text=True, timeout=5,
                                 check=False).stdout
            _TERMUX_API_OK = "com.termux.api" in (out or "")
        except Exception:                                         # noqa: BLE001
            _TERMUX_API_OK = False
    return _TERMUX_API_OK


def _scan_paths(paths: list[str]) -> None:
    """Tell Android's MediaProvider about new files (best effort)."""
    if not paths:
        return
    if termux_api_available() and shutil.which("termux-media-scan"):
        termux(["termux-media-scan", *paths], timeout=20)
        return
    # No Termux:API app -> ask the activity manager directly. The "--user 0"
    # part matters: without it Android rejects the broadcast for this uid.
    am = "/system/bin/am" if os.path.exists("/system/bin/am") else shutil.which("am")
    if not am:
        return
    for p in paths:
        try:
            subprocess.run(
                [am, "broadcast", "--user", "0",
                 "-a", "android.intent.action.MEDIA_SCANNER_SCAN_FILE",
                 "-d", f"file://{p}"],
                capture_output=True, text=True, timeout=15, check=False)
        except Exception:                                         # noqa: BLE001
            continue


def media_scan(paths: list[str], wait: float = 8.0) -> None:
    """Index downloaded files so the phone's Gallery app shows them.

    Runs in a daemon thread so a slow/absent media scanner can never stall the
    TUI, but we still join briefly (default 8s) so the usual case finishes
    before the process exits. The scan itself is best effort.
    """
    paths = [str(p) for p in paths if p]
    if not paths:
        return
    t = threading.Thread(target=_scan_paths, args=(paths,), daemon=True)
    t.start()
    try:
        t.join(timeout=wait)
    except KeyboardInterrupt:                                     # noqa: BLE001
        pass


